// Tire scrub sound: exact port of the user's Web Audio spec (audio_spec/tire_sound_spec.md). Constants and control laws are the spec's; do not retune.
// Graph per tire i (FL,FR,RL,RR): shared 1 s brown-noise loop (offset i*0.19 s) -> bandpass (body) -> gain -> StereoPanner
//                                 same loop (offset i*0.19+0.37 s) -> bandpass (overtone) -> gain -> same panner.
// AudioParams follow setTargetAtTime: per-sample one-pole v += (target - v) * (1 - exp(-1 / (fs * tau))).
// Targets are computed at frame rate on the main thread (like the JS rAF loop) and handed to the audio thread under a lock.
using UnityEngine;
public static class TireScrubLaw
{
    public static readonly float[] Pan = { -0.45f, 0.45f, -0.7f, 0.7f };
    public static float BodyHz(int i) => 230f * (1f + (i - 1.5f) * 0.025f);           // 221.375, 227.125, 232.875, 238.625
    public static readonly float OverMul = Mathf.Pow(2f, 1f / 6f);                    // overtone = body hz * 2^(1/6)
    public const float BodyHzStart = 140f, OverHzStart = 258f, StartQ = 0.8f, OverQ = 0.8f;
    public const float TauBodyF = 0.04f, TauBodyQ = 0.05f, TauBodyG = 0.05f, TauPan = 0.1f, TauOverF = 0.08f, TauOverQ = 0.05f, TauOverG = 0.55f;
    public static float Smoothstep(float e0, float e1, float x) { float t = Mathf.Clamp01((x - e0) / (e1 - e0)); return t * t * (3f - 2f * t); }
    /// alpha in rad, kappa slip ratio, ap/kp = peak slip angle (rad) / peak slip ratio of OUR Pacejka at the wheel's current load
    public static float ScrubRatio(float alphaRad, float kappa, float apRad, float kp) { float ap = Mathf.Max(0.05f, apRad), k = Mathf.Max(0.04f, kp); float a = Mathf.Abs(alphaRad) / ap, b = Mathf.Abs(kappa) / k; return Mathf.Sqrt(a * a + b * b); }
    public static float ScrubQ(float ratio) => ratio <= 1f ? 0.7f : Mathf.Min(0.95f, 0.7f + (ratio - 1f) * 0.2f);
    public static float ScrubLoud(float speed, float fz, float ratio)
    {
        float moving = Smoothstep(1f, 6f, speed), load = Smoothstep(800f, 4500f, fz), work = Smoothstep(0.1f, 1f, Mathf.Min(ratio, 1f));
        float level = Mathf.Clamp01(load * 0.5f + work * 0.8f); return level * moving * 0.06f;
    }
    public static float OverAmt(float ratio) { float over = Mathf.Max(0f, ratio - 1f); return Mathf.Clamp01((over - 0.45f) / 0.85f); }
    public static float OverGain(float ratio, float rub, float speed) => OverAmt(ratio) * rub * 1.12f * (speed > 2f ? 1f : 0f);
    // peak of our Pacejka curves at load fz (pure slip, zero camber): golden-section on |F| (curves are unimodal on these ranges)
    public static float PeakAlpha(CarParams p, float fz) => Peak(x => Mathf.Abs(PacejkaTire.PureLat(p, x, Mathf.Max(fz, 1f), 0f)), 0.002f, 0.6f);
    public static float PeakKappa(CarParams p, float fz) => Peak(x => Mathf.Abs(PacejkaTire.PureLong(p, x, Mathf.Max(fz, 1f))), 0.002f, 1.0f);
    static float Peak(System.Func<float, float> f, float lo, float hi)
    {
        // coarse scan then golden refine (robust to a flat tail)
        int n = 60; float best = lo, bv = -1f; for (int i = 0; i <= n; i++) { float x = lo + (hi - lo) * i / n, v = f(x); if (v > bv) { bv = v; best = x; } }
        float a = Mathf.Max(lo, best - (hi - lo) / n), b = Mathf.Min(hi, best + (hi - lo) / n); const float g = 0.618034f;
        for (int k = 0; k < 40; k++) { float c = b - g * (b - a), d = a + g * (b - a); if (f(c) > f(d)) b = d; else a = c; }
        return 0.5f * (a + b);
    }
}
/// Web Audio BiquadFilterNode 'bandpass' (RBJ cookbook BPF, constant 0 dB peak gain), Direct Form I, coefficients recomputed per sample from smoothed params.
public struct Biquad
{
    double x1, x2, y1, y2;
    public float Process(float x, float fs, float hz, float q)
    {
        double w0 = 2.0 * System.Math.PI * hz / fs, al = System.Math.Sin(w0) / (2.0 * System.Math.Max(q, 1e-4)), a0 = 1.0 + al;
        double b0 = al / a0, b2 = -al / a0, a1 = -2.0 * System.Math.Cos(w0) / a0, a2 = (1.0 - al) / a0;
        double y = b0 * x + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; return (float)y;
    }
    public static double Magnitude(float fs, float hz, float q, float f)   // |H| at frequency f, for tests
    {
        double w0 = 2 * System.Math.PI * hz / fs, al = System.Math.Sin(w0) / (2 * q), w = 2 * System.Math.PI * f / fs;
        var z1 = new System.Numerics.Complex(System.Math.Cos(-w), System.Math.Sin(-w)); var z2 = z1 * z1;
        return ((al - al * z2) / ((1 + al) - 2 * System.Math.Cos(w0) * z1 + (1 - al) * z2)).Magnitude;
    }
}
public class TireScrubDsp
{
    public readonly float fs; public readonly float[] buffer;   // shared mono loop
    readonly int[] posB = new int[4], posO = new int[4]; Biquad[] bpB = new Biquad[4], bpO = new Biquad[4];
    readonly float[] bF = new float[4], bQ = new float[4], bG = new float[4], pan = new float[4], oF = new float[4], oQ = new float[4], oG = new float[4];
    // targets (written by the main thread, read by the audio thread at block start)
    readonly object gate = new object(); readonly float[] tBG = new float[4], tBQ = new float[4], tOG = new float[4]; readonly float[] cBG = new float[4], cBQ = new float[4], cOG = new float[4];
    public bool bodyOn = true, overOn = true;   // test taps
    public TireScrubDsp(float sampleRate, float[] sourceOverride = null, int seed = 1984)
    {
        fs = sampleRate; int n = Mathf.RoundToInt(fs);
        if (sourceOverride != null) buffer = sourceOverride;
        else
        {
            buffer = new float[n]; var rng = new System.Random(seed); double brown = 0, peak = 0;
            for (int i = 0; i < n; i++) { brown = brown * 0.97 + (rng.NextDouble() * 2 - 1) * 0.03; buffer[i] = (float)brown; peak = System.Math.Max(peak, System.Math.Abs(brown)); }
            float k = (float)(0.85 / System.Math.Max(peak, 1e-9)); for (int i = 0; i < n; i++) buffer[i] *= k;   // peak-normalise to 0.85
        }
        for (int i = 0; i < 4; i++)
        {
            posB[i] = Mathf.RoundToInt(i * 0.19f * fs) % buffer.Length; posO[i] = Mathf.RoundToInt((i * 0.19f + 0.37f) * fs) % buffer.Length;
            bF[i] = TireScrubLaw.BodyHzStart; bQ[i] = TireScrubLaw.StartQ; bG[i] = 0f; pan[i] = 0f;
            oF[i] = TireScrubLaw.OverHzStart; oQ[i] = TireScrubLaw.OverQ; oG[i] = 0f; tBQ[i] = TireScrubLaw.StartQ;
        }
    }
    public void SetTargets(float[] bodyGain, float[] bodyQ, float[] overGain) { lock (gate) { for (int i = 0; i < 4; i++) { tBG[i] = bodyGain[i]; tBQ[i] = bodyQ[i]; tOG[i] = overGain[i]; } } }
    static float K(float fs, float tau) => 1f - Mathf.Exp(-1f / (fs * tau));
    /// renders n frames into data (interleaved, ch channels; ch==1 -> mono sum), overwriting, times outGain
    public void Render(float[] data, int n, int ch, float outGain)
    {
        lock (gate) { System.Array.Copy(tBG, cBG, 4); System.Array.Copy(tBQ, cBQ, 4); System.Array.Copy(tOG, cOG, 4); }
        float kBF = K(fs, TireScrubLaw.TauBodyF), kBQ = K(fs, TireScrubLaw.TauBodyQ), kBG = K(fs, TireScrubLaw.TauBodyG), kP = K(fs, TireScrubLaw.TauPan),
              kOF = K(fs, TireScrubLaw.TauOverF), kOQ = K(fs, TireScrubLaw.TauOverQ), kOG = K(fs, TireScrubLaw.TauOverG); int L = buffer.Length;
        for (int s = 0; s < n; s++)
        {
            float l = 0f, r = 0f;
            for (int i = 0; i < 4; i++)
            {
                float hz = TireScrubLaw.BodyHz(i);
                bF[i] += kBF * (hz - bF[i]); bQ[i] += kBQ * (cBQ[i] - bQ[i]); bG[i] += kBG * (cBG[i] - bG[i]); pan[i] += kP * (TireScrubLaw.Pan[i] - pan[i]);
                oF[i] += kOF * (hz * TireScrubLaw.OverMul - oF[i]); oQ[i] += kOQ * (TireScrubLaw.OverQ - oQ[i]); oG[i] += kOG * (cOG[i] - oG[i]);
                float body = bpB[i].Process(buffer[posB[i]], fs, bF[i], bQ[i]) * bG[i], over = bpO[i].Process(buffer[posO[i]], fs, oF[i], oQ[i]) * oG[i];
                if (++posB[i] >= L) posB[i] = 0; if (++posO[i] >= L) posO[i] = 0;
                float m = (bodyOn ? body : 0f) + (overOn ? over : 0f);
                float x = (pan[i] + 1f) * 0.5f;                       // Web Audio StereoPanner, mono input: equal-power
                l += m * Mathf.Cos(x * 0.5f * Mathf.PI); r += m * Mathf.Sin(x * 0.5f * Mathf.PI);
            }
            if (ch == 1) data[s] = (l + r) * outGain; else { data[s * ch] = l * outGain; data[s * ch + 1] = r * outGain; for (int c = 2; c < ch; c++) data[s * ch + c] = 0f; }
        }
    }
}
